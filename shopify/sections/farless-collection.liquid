{%- comment -%}
  A collection page in the Farless style: each product stands alone on the dark page as its cut-out,
  in the soft light and with the contact shadow of its product page (the card snippet), with a heart. Cut-outs come from the first
  colour's variant image (or the product's first picture); Shadow position (farless.foot_x) places the
  shadow. Products with photos instead of cut-outs can fill the card with the Pictures setting.
{%- endcomment -%}
{%- paginate collection.products by section.settings.per_page -%}
{%- render 'farless-arc', arc: section.settings.arc -%}
<section class="cl{% if section.settings.tone %} tone{% endif %}" aria-labelledby="h-{{ section.id }}">
  <div class="wrap">
    <nav class="crumbs label" aria-label="Breadcrumb"><a href="{{ routes.root_url }}#shop">{{ section.settings.shop_crumb | escape }}</a><span aria-hidden="true">/</span><span aria-current="page">{{ collection.title | escape }}</span></nav>
    <div class="cl-head" data-in>
      <div>
        <span class="label kicker part">{{ section.settings.kicker | escape }}</span>
        <h1 class="h2 part" id="h-{{ section.id }}">{{ collection.title | escape }}</h1>
        {%- assign about = collection.description | strip_html | strip -%}
        {%- if about != blank %}
        <p class="lede part">{{ about | escape }}</p>
        {%- endif %}
      </div>
      {%- if collection.products_count > 0 %}
      <span class="label part">{% if collection.products_count == 1 %}1 {{ section.settings.piece_label | escape }}{% else %}{{ collection.products_count }} {{ section.settings.pieces_label | escape }}{% endif %}</span>
      {%- endif %}
    </div>

    {%- if collection.products.size > 0 %}
    <ul class="cl-grid" data-in>
      {%- for product in collection.products -%}
        {%- render 'farless-card', product: product, pictures: section.settings.pictures, show_prices: section.settings.show_prices, sold_out_label: section.settings.sold_out_label, colours_label: section.settings.colours_label, save_label: section.settings.save_label, item_class: 'part' -%}
      {%- endfor %}
    </ul>
    {%- if paginate.pages > 1 %}
    <nav class="cl-pages" aria-label="{{ section.settings.pages_label | escape }}">
      {%- if paginate.previous %}<a class="link" href="{{ paginate.previous.url }}">{{ section.settings.previous_label | escape }}</a>{% endif -%}
      {%- if paginate.next %}<a class="link" href="{{ paginate.next.url }}">{{ section.settings.next_label | escape }}</a>{% endif -%}
    </nav>
    {%- endif %}
    {%- else %}
    <div class="cl-empty" data-in>
      <p class="part">{{ section.settings.empty_text | escape }}</p>
      <a class="link part" href="{{ routes.root_url }}#shop">{{ section.settings.empty_link_label | escape }}</a>
    </div>
    {%- endif %}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Farless collection",
  "tag": "div",
  "class": "farless-collection",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small label", "default": "Collection" },
    { "type": "select", "id": "pictures", "label": "Pictures", "default": "cutout", "options": [ { "value": "cutout", "label": "Cut-outs on the dark page" }, { "value": "photo", "label": "Photos that fill the card" } ], "info": "Cut-outs use each product's first colour picture; photos use its first picture." },
    { "type": "checkbox", "id": "show_prices", "default": false, "label": "Show prices" },
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 6, "max": 48, "step": 6, "default": 24 },
    { "type": "header", "content": "Labels" },
    { "type": "text", "id": "shop_crumb", "label": "First link in the trail", "default": "Shop" },
    { "type": "text", "id": "piece_label", "label": "One product", "default": "piece" },
    { "type": "text", "id": "pieces_label", "label": "Several products", "default": "pieces" },
    { "type": "text", "id": "colours_label", "label": "Colours", "default": "colours" },
    { "type": "text", "id": "sold_out_label", "label": "Sold out", "default": "Sold out" },
    { "type": "text", "id": "save_label", "label": "Heart button, for screen readers", "default": "Save to favourites" },
    { "type": "text", "id": "empty_text", "label": "Empty collection", "default": "Coming soon." },
    { "type": "text", "id": "empty_link_label", "label": "Link from an empty collection", "default": "Back to the shop" },
    { "type": "text", "id": "pages_label", "label": "Page links name", "default": "More pieces" },
    { "type": "text", "id": "previous_label", "label": "Previous page", "default": "Previous" },
    { "type": "text", "id": "next_label", "label": "Next page", "default": "Next" },
    { "type": "header", "content": "Layout" },
    { "type": "checkbox", "id": "tone", "label": "Slightly lighter background", "default": false },
    { "type": "select", "id": "arc", "label": "Arc line above", "default": "none", "options": [ { "value": "none", "label": "None" }, { "value": "left", "label": "From the left" }, { "value": "right", "label": "From the right" } ] }
  ]
}
{% endschema %}
