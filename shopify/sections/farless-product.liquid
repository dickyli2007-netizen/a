{%- comment -%}
  The Farless product page, rendered for any product. build_shopify.py fills in the template's styles
  and the swatch fills; the slide and picker script is in assets/farless.js.
  Colours come from an option named Colour, Color or Finish; each colour shows its variant's image
  (a transparent cut-out). Product fields in the farless namespace carry the page copy:
  kicker, lede, notes (one per line, "Label | text") and foot_x (where the product's foot is, in %).
  After Gessi's: beside the product only its name, the colour picker and the button; the small heading,
  tagline, description and notes sit below the product. The description there leaves out an opening
  paragraph that only repeats the tagline, since the tagline is the heading above it.
{%- endcomment -%}
{%- liquid
  assign current = product.selected_or_first_available_variant
  assign colour_option = blank
  for option in product.options_with_values
    assign oname = option.name | downcase | strip
    if oname == 'colour' or oname == 'color' or oname == 'finish' or oname == 'colours' or oname == 'colors'
      assign colour_option = option
      break
    endif
  endfor

  assign colour_pos = -1
  assign start = 0
  assign slide_count = 1
  if colour_option != blank
    assign colour_pos = colour_option.position | minus: 1
    assign slide_count = colour_option.values.size
    for value in colour_option.values
      if current.options[colour_pos] == value.name
        assign start = forloop.index0
      endif
    endfor
  endif

  assign kicker = product.metafields.farless.kicker.value | default: section.settings.kicker
  assign lede = product.metafields.farless.lede.value
  assign foot_x = product.metafields.farless.foot_x.value

  assign excerpt = ''
  assign paras = product.description | split: '</p>'
  for para in paras
    assign text = para | strip_html | strip
    if text != blank and text != lede
      assign excerpt = text
      break
    endif
  endfor

  assign full = product.description
  assign opening = paras.first | strip_html | strip
  if lede != blank and opening == lede
    assign full = product.description | remove_first: paras.first | remove_first: '</p>' | strip
  endif
  assign notes = product.metafields.farless.notes.value | strip
-%}
{%- capture nl %}
{% endcapture -%}
<style>
/* ---------- product page, after Gessi's: the product alone with its name, colour and button beside it; the details below ---------- */
.pdp{padding:calc(118px + env(safe-area-inset-top, 0px)) var(--gutter) clamp(96px,13vh,150px)}
.crumbs{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:clamp(20px,3vh,36px)}
.crumbs a{text-decoration:none;color:var(--text-secondary);transition:color .35s var(--ease-out)}
.crumbs a:hover{color:var(--text-primary)}
.crumbs [aria-current]{color:var(--text-primary)}
.pdp-grid{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(0,1fr);gap:clamp(40px,6vw,110px);align-items:center}
.stage-col{min-width:0}
.stage{position:relative;height:min(72vh,760px);min-height:420px;touch-action:pan-y;cursor:grab;user-select:none;-webkit-user-select:none;
  -webkit-mask-image:linear-gradient(90deg,transparent,#000 9%,#000 91%,transparent);mask-image:linear-gradient(90deg,transparent,#000 9%,#000 91%,transparent)}
.stage.dragging{cursor:grabbing}
/* a soft warm light behind the tap, so dark finishes still read against the page */
.stage::before{content:"";position:absolute;inset:0;pointer-events:none;background:radial-gradient(46% 42% at 50% 52%,rgba(236,227,214,.085),rgba(236,227,214,0) 72%)}
.tap{position:absolute;inset:0;margin:0;will-change:transform,opacity;backface-visibility:hidden}
.tap:not(.is-on){opacity:0}
.stage.single{cursor:auto}
.tap .obj{position:absolute;left:50%;bottom:6%;height:86%;max-width:100%;aspect-ratio:var(--ar);translate:-50% 0}
.tap img{display:block;width:100%;height:100%;max-width:none;object-fit:contain;-webkit-user-drag:none;pointer-events:none}
/* contact shadow under the product's foot; each product file says where its foot is */
.tap .obj::after{content:"";position:absolute;z-index:-1;left:var(--shadow-x,50%);top:98.4%;width:var(--shadow-w,34%);height:5%;translate:-50% -50%;background:radial-gradient(closest-side,rgba(4,3,2,.8),rgba(4,3,2,0))}
.f-rail{display:flex;align-items:center;gap:22px;margin-top:18px}
.f-rail .bar{position:relative;flex:1;height:1px;background:var(--hair)}
.f-rail .bar i{position:absolute;left:0;top:0;height:1px;width:calc(100% / var(--n,4));background:var(--text-primary);transform:translate3d(calc(var(--pos,0) * 100%),0,0);transition:transform 1.05s cubic-bezier(.45,0,.15,1)}
.f-rail.live .bar i{transition:none}
.f-rail .label{flex:none;font-variant-numeric:tabular-nums;letter-spacing:.2em}
.f-rail .label b{font-weight:400;color:var(--text-primary)}
/* beside the product only its name, the colour and the button, so the eye stays on the piece */
.buy-col{min-width:0;max-width:440px}
.buy-col h1{font:200 clamp(2.2rem,3.3vw,3.3rem)/1.08 var(--font);letter-spacing:-.005em}
.buy-col .price{margin-top:16px;font:300 1.15rem/1 var(--font);letter-spacing:.06em}
.finish{margin-top:clamp(34px,6vh,60px)}
.finish-h{font:400 clamp(1.3rem,1.8vw,1.65rem)/1.25 var(--font);color:var(--text-primary)}
.finish-h span{font-weight:300;color:var(--text-secondary)}
.finish-name{display:flex;align-items:baseline;gap:14px;margin-top:20px;font:400 1rem/1.4 var(--font);letter-spacing:.02em}
.finish-name b{display:inline-block;font-weight:400}
.swatches{display:flex;flex-wrap:wrap;gap:8px;margin:14px 0 0 -7px}
.swatches button{all:unset;box-sizing:border-box;position:relative;width:48px;height:48px;border-radius:50%;cursor:pointer;-webkit-tap-highlight-color:transparent}
.swatches button::before{content:"";position:absolute;inset:7px;border-radius:50%;background:var(--sw);box-shadow:inset 0 0 0 1px rgba(255,255,255,.14),inset 0 -5px 9px rgba(0,0,0,.22);transition:transform .5s var(--ease-out)}
.swatches button::after{content:"";position:absolute;inset:2px;border-radius:50%;border:1px solid var(--text-primary);opacity:0;transform:scale(.86);transition:opacity .45s var(--ease-out),transform .55s var(--ease-out),border-color .3s var(--ease-out)}
.swatches button:hover::after{opacity:.35;transform:none}
.swatches button[aria-checked="true"]::after{opacity:1;transform:none}
.swatches button:active::before{transform:scale(.94)}
.swatches button:focus-visible{outline:none}
.swatches button:focus-visible::after{opacity:1;transform:none;border-color:var(--accent)}
.opts{display:grid;gap:14px;margin-top:30px}
.opt{display:grid;gap:10px}
.opt select{font:300 1rem/1.4 var(--font);color:var(--text-primary);background:transparent;border:1px solid var(--hair-strong);padding:12px 14px;border-radius:0}
.opt select:focus-visible{outline:1px solid var(--accent);outline-offset:3px}
.buy-actions{display:grid;gap:14px;margin-top:clamp(32px,5vh,48px)}
.buy-actions form{display:grid;gap:14px;margin:0}
.buy-actions .btn{justify-content:center;cursor:pointer;font-family:var(--font)}
.buy-note{grid-column:1 / -1;min-height:1.6em;color:var(--text-secondary);font-size:.92rem;line-height:1.6}
/* the details, below the product: the tagline large, the description beside it, the notes across */
.pdp-more{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(0,1fr);column-gap:clamp(40px,6vw,110px);margin-top:clamp(72px,11vh,130px);padding-top:clamp(56px,8vh,88px);border-top:1px solid var(--hair)}
.more-head{display:contents}
.more-head .label{grid-column:1 / -1}
.more-head h2{min-width:0;font:200 clamp(2rem,3.4vw,3.2rem)/1.12 var(--font);letter-spacing:-.005em;max-width:18ch}
.more-copy{grid-column:2;min-width:0;max-width:440px;color:var(--text-secondary);line-height:1.75;padding-top:6px}
.more-copy > * + *{margin-top:1em}
.more-copy ul,.more-copy ol{padding-left:1.1em}
.more-copy li + li{margin-top:.45em}
.more-copy strong,.more-copy b{font-weight:400;color:var(--text-primary)}
.more-copy a{color:var(--text-primary)}
.pdp-more .f-notes{grid-column:1 / -1;margin-top:clamp(48px,7vh,72px)}
@media (max-width:860px){
  .pdp{padding-top:calc(94px + env(safe-area-inset-top, 0px))}
  .crumbs{display:none}
  .pdp-grid{grid-template-columns:1fr;row-gap:0}
  .buy-col{display:contents}
  .buy-col h1{order:1}
  .buy-col .price{order:2;margin-top:8px}
  .stage-col{order:3;margin-top:4px}
  .stage{height:min(50vh,520px);min-height:280px}
  .finish{order:4;margin-top:20px}
  .opts{order:4}
  .buy-actions{order:5;margin-top:28px}
  .pdp-more{grid-template-columns:1fr;margin-top:72px;padding-top:48px}
  .more-copy{grid-column:auto;max-width:none;margin-top:24px;padding-top:0}
}
@media (max-width:600px){
  .pdp{padding-top:calc(84px + env(safe-area-inset-top, 0px))}
  .stage{height:min(44vh,440px);min-height:260px}
  .f-rail{margin-top:12px}
  .finish-name{margin-top:12px}
  .swatches{margin-top:8px}
  .buy-actions{margin-top:22px}
}
</style>
<div class="pdp">
  <div class="wrap">
    <nav class="crumbs label" aria-label="Breadcrumb"><a href="{{ routes.root_url }}#shop">{{ section.settings.shop_crumb | escape }}</a><span aria-hidden="true">/</span>
      {%- liquid
        assign crumb = blank
        for c in product.collections
          unless c.handle == 'frontpage'
            assign crumb = c
            break
          endunless
        endfor
      -%}
      {%- if crumb != blank -%}<a href="{{ crumb.url }}">{{ crumb.title | escape }}</a><span aria-hidden="true">/</span>{%- endif -%}
      <span aria-current="page">{{ product.title | escape }}</span></nav>
    <div class="pdp-grid">
      <div class="stage-col" style="--n:{{ slide_count }}">
        <div class="stage{% if slide_count < 2 %} single{% endif %}" data-stage data-start="{{ start }}" style="--shadow-x:{{ foot_x | default: 50 }}%;--shadow-w:{% if foot_x != blank %}34{% else %}0{% endif %}%"
          {%- if slide_count > 1 %} aria-roledescription="carousel" aria-label="{{ product.title | escape }} in {{ slide_count }} colours"{% else %} aria-label="{{ product.title | escape }}"{% endif %}>
          {%- if colour_option != blank -%}
            {%- for value in colour_option.values -%}
              {%- liquid
                assign media = blank
                for v in product.variants
                  if v.options[colour_pos] == value.name and v.featured_media
                    assign media = v.featured_media
                    break
                  endif
                endfor
                if media == blank
                  assign media = product.featured_media
                endif
                assign colour_lc = value.name | downcase
                assign alt = 'The ' | append: product.title | append: ' in ' | append: colour_lc
              -%}
          <figure class="tap{% if forloop.index0 == start %} is-on{% endif %}"{% unless forloop.index0 == start %} aria-hidden="true"{% endunless %}><div class="obj" style="--ar:{{ media.preview_image.aspect_ratio | default: 0.65 }}">
            {%- if media != blank -%}{{ media.preview_image | image_url: width: 1400 | image_tag: widths: '500, 800, 1100, 1400', sizes: '(min-width: 860px) 46vw, 80vw', alt: alt, draggable: 'false' }}{%- endif -%}
          </div></figure>
            {%- endfor -%}
          {%- else -%}
          <figure class="tap is-on"><div class="obj" style="--ar:{{ product.featured_media.preview_image.aspect_ratio | default: 0.65 }}">
            {%- if product.featured_media -%}{{ product.featured_media.preview_image | image_url: width: 1400 | image_tag: widths: '500, 800, 1100, 1400', sizes: '(min-width: 860px) 46vw, 80vw', alt: product.title, draggable: 'false' }}{%- endif -%}
          </div></figure>
          {%- endif %}
        </div>
        {%- if slide_count > 1 %}
        <div class="f-rail" aria-hidden="true" style="--pos:{{ start }}"><span class="bar"><i></i></span><span class="label"><b data-count>{% if start < 9 %}0{% endif %}{{ start | plus: 1 }}</b> / {% if slide_count < 10 %}0{% endif %}{{ slide_count }}</span></div>
        {%- endif %}
      </div>
      <div class="buy-col">
        <h1>{{ product.title | escape }}</h1>
        {%- if section.settings.show_prices %}
        <p class="price" data-price>{{ current.price | money }}</p>
        {%- endif -%}
        {%- if slide_count > 1 %}
        <div class="finish">
          <p class="finish-h">{{ section.settings.colour_heading | escape }} <span>{{ section.settings.colour_subheading | escape }}</span></p>
          <p class="finish-name"><span class="label">{{ section.settings.colour_label | escape }}</span><b data-finish-name>{{ colour_option.values[start].name | escape }}</b></p>
          <div class="swatches" role="radiogroup" aria-label="{{ section.settings.colour_label | escape }}">
            {%- for value in colour_option.values -%}
              {%- liquid
                assign key = value.name | downcase
                assign sw = 'linear-gradient(135deg,#d8d1c7 0%,#8f877c 50%,#5e574f 100%)'
                if value.swatch.color
                  assign sw = value.swatch.color
                elsif key contains 'chrome' or key contains 'steel' or key contains 'nickel' or key contains 'silver'
                  assign sw = 'linear-gradient(135deg,#fbfbfc 0%,#c3c6ca 38%,#eef0f2 56%,#8c9095 100%)'
                elsif key contains 'brass' or key contains 'gold'
                  assign sw = 'linear-gradient(135deg,#f6e4b0 0%,#c09a52 40%,#e3c682 58%,#7a5822 100%)'
                elsif key contains 'copper' or key contains 'rose' or key contains 'bronze'
                  assign sw = 'linear-gradient(135deg,#f4d0bb 0%,#b5714f 40%,#dca184 58%,#6c3822 100%)'
                elsif key contains 'black' or key contains 'graphite' or key contains 'gunmetal'
                  assign sw = 'linear-gradient(135deg,#5b5651 0%,#1c1a19 42%,#2e2b29 60%,#0c0b0a 100%)'
                elsif key contains 'white'
                  assign sw = 'linear-gradient(135deg,#ffffff 0%,#e7e3dd 45%,#f6f3ee 60%,#bdb7ae 100%)'
                endif
              -%}
            <button type="button" role="radio" aria-checked="{% if forloop.index0 == start %}true{% else %}false{% endif %}" tabindex="{% if forloop.index0 == start %}0{% else %}-1{% endif %}" aria-label="{{ value.name | escape }}" style="--sw:{{ sw }}"></button>
            {%- endfor %}
          </div>
        </div>
        {%- endif -%}
        {%- unless product.has_only_default_variant %}
          {%- capture other_options -%}
            {%- for option in product.options_with_values -%}
              {%- assign pos = option.position | minus: 1 -%}
              {%- unless pos == colour_pos -%}
          <label class="opt"><span class="label">{{ option.name | escape }}</span><select data-option="{{ pos }}">
            {%- for value in option.values -%}<option value="{{ value.name | escape }}"{% if value.selected %} selected{% endif %}>{{ value.name | escape }}</option>{%- endfor -%}
          </select></label>
              {%- endunless -%}
            {%- endfor -%}
          {%- endcapture -%}
          {%- if other_options != blank %}
        <div class="opts">{{ other_options }}</div>
          {%- endif -%}
        {%- endunless %}
        {%- comment -%} each colour is its own favourite: the heart saves the chosen colour and follows the picker {%- endcomment -%}
        {%- liquid
          assign heart_media = current.featured_media | default: product.featured_media
          assign heart_image = ''
          if heart_media
            assign heart_image = heart_media.preview_image | image_url: width: 300
          endif
          assign heart_colour = ''
          if colour_pos >= 0
            assign heart_colour = current.options[colour_pos]
          endif
        -%}
        <div class="buy-actions has-fav" id="buy">
          {%- form 'product', product, class: 'buy-form' -%}
            <input type="hidden" name="id" value="{{ current.id }}">
            <button class="btn solid" type="submit" name="add" data-add data-label-add="{{ section.settings.add_label | escape }}" data-label-sold="{{ section.settings.sold_out_label | escape }}" data-label-none="{{ section.settings.unavailable_label | escape }}"{% unless current.available %} disabled{% endunless %}>{% if current.available %}{{ section.settings.add_label | escape }}{% else %}{{ section.settings.sold_out_label | escape }}{% endif %}</button>
          {%- endform -%}
          <button type="button" class="fav big" data-fav="{{ product.handle }}:{{ current.id }}" data-fav-handle="{{ product.handle }}" data-fav-variant="{{ current.id }}" data-fav-base="{{ product.url }}" data-fav-title="{{ product.title | escape }}" data-fav-url="{{ product.url }}?variant={{ current.id }}" data-fav-image="{{ heart_image }}" data-fav-sub="{{ heart_colour | escape }}" data-label-save="{{ section.settings.save_label | escape }}" aria-pressed="false" aria-label="{{ section.settings.save_label | escape }}: {{ product.title | escape }}{% if heart_colour != blank %}, {{ heart_colour | escape }}{% endif %}">{% render 'farless-heart' %}</button>
        </div>
      </div>
    </div>
    {%- liquid
      assign show_copy = false
      if section.settings.description == 'full' and full != blank
        assign show_copy = true
      elsif section.settings.description == 'first' and excerpt != blank
        assign show_copy = true
      endif
    -%}
    {%- if lede != blank or show_copy or notes != blank %}
    <section class="pdp-more" aria-label="{{ product.title | escape }}: {{ section.settings.details_label | escape }}">
      <div class="more-head">
        <span class="label kicker">{{ kicker | escape }}</span>
        {%- if lede != blank %}
        <h2>{{ lede | escape }}</h2>
        {%- endif %}
      </div>
      {%- if show_copy %}
      <div class="more-copy">{% if section.settings.description == 'full' %}{{ full }}{% else %}<p>{{ excerpt | escape }}</p>{% endif %}</div>
      {%- endif -%}
      {%- if notes != blank %}
      <ul class="f-notes">
        {%- assign lines = notes | split: nl -%}
        {%- for line in lines -%}
          {%- assign parts = line | split: '|' -%}
          {%- assign note_label = parts.first | strip -%}
          {%- assign note_text = parts | slice: 1, 9 | join: '|' | strip -%}
          {%- if note_label != blank %}
        <li><span class="label">{{ note_label | escape }}</span>{{ note_text | escape }}</li>
          {%- endif -%}
        {%- endfor %}
      </ul>
      {%- endif %}
    </section>
    {%- endif %}
  </div>
</div>
<script type="application/json" data-variants data-colour-pos="{{ colour_pos }}">[
  {%- for v in product.variants -%}
  {"id":{{ v.id }},"available":{{ v.available | json }},"options":{{ v.options | json }},"price":{{ v.price | money | json }},"image":{% if v.featured_media %}{{ v.featured_media.preview_image | image_url: width: 300 | json }}{% else %}null{% endif %}}{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
]</script>

{% schema %}
{
  "name": "Farless product",
  "tag": "div",
  "class": "farless-product",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "paragraph", "content": "Each product fills this page by itself: its colours, its cut-out pictures and its Farless fields (Small heading, Tagline, Notes, Shadow position) in the product admin." },
    { "type": "text", "id": "kicker", "label": "Small heading", "default": "Farless", "info": "Used when the product has no Small heading field of its own." },
    { "type": "checkbox", "id": "show_prices", "default": false, "label": "Show prices" },
    { "type": "header", "content": "Details below the product" },
    { "type": "select", "id": "description", "label": "Description", "default": "first", "options": [ { "value": "first", "label": "Its first paragraph" }, { "value": "full", "label": "The whole description" }, { "value": "none", "label": "None" } ], "info": "The product's Small heading and Tagline head the details, and its Notes run across underneath. An opening paragraph that repeats the Tagline is left out." },
    { "type": "text", "id": "details_label", "label": "Details, for screen readers", "default": "details" },
    { "type": "header", "content": "Colour picker" },
    { "type": "text", "id": "colour_heading", "label": "Heading", "default": "Colour." },
    { "type": "text", "id": "colour_subheading", "label": "Heading, second part", "default": "Pick your favourite." },
    { "type": "text", "id": "colour_label", "label": "Label before the colour name", "default": "Colour" },
    { "type": "header", "content": "Labels" },
    { "type": "text", "id": "add_label", "label": "Add to cart button", "default": "Add to cart" },
    { "type": "text", "id": "sold_out_label", "label": "Sold out button", "default": "Sold out" },
    { "type": "text", "id": "save_label", "label": "Heart button, for screen readers", "default": "Save to favourites", "info": "The heart beside the button saves the piece to favourites in the shopper's browser." },
    { "type": "text", "id": "unavailable_label", "label": "Unavailable button", "default": "Unavailable", "info": "Shown when the chosen combination of options doesn't exist." },
    { "type": "text", "id": "shop_crumb", "label": "First link in the path above the product", "default": "Shop" }
  ]
}
{% endschema %}
