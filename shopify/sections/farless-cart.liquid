{%- comment -%}
  The cart page (/cart) in the Farless style: the pieces on the left with a tick on each, the checkout beside
  them. assets/farless.js draws it from Shopify's cart with the words set in the menu bar's Cart panel, the
  same as the cart that slides in from the bar; ticked pieces go to checkout now and the rest stay in the
  cart. Until the script has drawn it (or without it), the pieces show plainly with Shopify's own checkout.
{%- endcomment -%}
<section class="cl cart-page{% if section.settings.tone %} tone{% endif %}" aria-labelledby="h-{{ section.id }}">
  <nav class="crumbs label" aria-label="Breadcrumb"><a href="{{ routes.root_url }}#shop">{{ section.settings.shop_crumb | escape }}</a><span aria-hidden="true">/</span><span aria-current="page">{{ section.settings.kicker | escape }}</span></nav>
  <div class="wrap">
    <div class="cl-head">
      <div>
        <span class="label kicker">{{ section.settings.kicker | escape }}</span>
        <h1 class="h2" id="h-{{ section.id }}">{{ section.settings.heading | escape }}</h1>
        {%- if section.settings.lede != blank %}
        <p class="lede">{{ section.settings.lede | escape }}</p>
        {%- endif %}
      </div>
    </div>
    <div class="ct-view{% if cart.item_count == 0 %} is-empty{% endif %}" data-cart-view>
      {%- if cart.item_count > 0 %}
      <div class="ct-main">
        <ul class="ct-list">
          {%- for item in cart.items %}
          <li class="ct-line plain">
            <a class="ct-thumb" href="{{ item.url }}" tabindex="-1" aria-hidden="true">{% if item.image %}{{ item.image | image_url: width: 240 | image_tag: alt: '', loading: 'lazy' }}{% endif %}</a>
            <div class="ct-info">
              <h3><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h3>
              {%- unless item.product.has_only_default_variant %}<span class="ct-sub">{{ item.variant.title | escape }}</span>{% endunless %}
              <span class="ct-sub">&times; {{ item.quantity }}</span>
            </div>
          </li>
          {%- endfor %}
        </ul>
      </div>
      <form class="ct-foot" action="{{ routes.cart_url }}" method="post">
        <button type="submit" name="checkout" class="btn solid ct-go">{{ section.settings.checkout_label | escape }}</button>
      </form>
      {%- else %}
      <p class="ct-empty">{{ section.settings.empty_text | escape }}</p>
      {%- endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Farless cart",
  "tag": "div",
  "class": "farless-cart",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "paragraph", "content": "The ticks, buttons and words in the cart itself are set in the menu bar, under Cart panel." },
    { "type": "text", "id": "kicker", "label": "Small label", "default": "Cart" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your cart." },
    { "type": "text", "id": "lede", "label": "Line under the heading", "info": "Leave empty for none." },
    { "type": "text", "id": "shop_crumb", "label": "First link in the trail", "default": "Shop" },
    { "type": "text", "id": "checkout_label", "label": "Checkout button, before the cart has loaded", "default": "Check out" },
    { "type": "text", "id": "empty_text", "label": "Empty cart, before the cart has loaded", "default": "Your cart is empty." },
    { "type": "checkbox", "id": "tone", "label": "Slightly lighter background", "default": false }
  ]
}
{% endschema %}
