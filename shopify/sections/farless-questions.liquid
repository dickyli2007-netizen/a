{%- comment -%} Questions: one block per question; each opens to show its answer. {%- endcomment -%}
{%- render 'farless-arc', arc: section.settings.arc -%}
<section class="sec faq{% if section.settings.tone %} tone{% endif %}" id="{{ section.settings.anchor | default: 'questions' | handleize }}" aria-labelledby="h-{{ section.id }}">
  <div class="wrap">
    <div class="side" data-in>
      <span class="label kicker part">{{ section.settings.kicker | escape }}</span>
      <h2 class="h2 part" id="h-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.lede != blank %}
      <p class="lede part">{{ section.settings.lede | escape }}</p>
      {%- endif %}
      <span class="drop part" aria-hidden="true"></span>
    </div>
    <div>
      {%- for block in section.blocks %}
      <details {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}<span class="pm" aria-hidden="true"></span></summary>{{ block.settings.answer }}</details>
      {%- endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Farless questions",
  "tag": "div",
  "class": "farless-questions",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 20,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small label", "default": "Questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Good to know." },
    { "type": "text", "id": "lede", "label": "Line under the heading", "default": "Everything you need to know about your Farless 5-in-1 Tap.", "info": "Leave empty for none." },
    { "type": "header", "content": "Layout" },
    { "type": "text", "id": "anchor", "label": "Link name", "default": "questions", "info": "Menu links ending in #questions jump here." },
    { "type": "checkbox", "id": "tone", "label": "Slightly lighter background", "default": false },
    { "type": "select", "id": "arc", "label": "Arc line above", "default": "none", "options": [ { "value": "none", "label": "None" }, { "value": "left", "label": "From the left" }, { "value": "right", "label": "From the right" } ] }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Is it safe with children around?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Yes. Boiling water needs a push and a turn at the same time, so it can't start by accident.</p>" }
      ]
    }
  ],
  "presets": [
    {"name": "Farless questions", "blocks": [{"type": "question", "settings": {"question": "What makes Farless different?", "answer": "<p>Five waters from one beautifully made tap: hot, cold, filtered, boiling and sparkling.</p><p>From washing up to your favourite drinks, Farless makes the kitchen simpler without giving up an ounce of style.</p>"}}, {"type": "question", "settings": {"question": "What comes with my Farless?", "answer": "<p>Your Farless 5-in-1 Tap, plus everything it needs to pour boiling and sparkling water.</p><p>Filtered water runs through a separate filtration system, which isn't included.</p>"}}, {"type": "question", "settings": {"question": "Can I use my own water filter?", "answer": "<p>Yes. Farless connects to a separate filtration system, so the choice of filter is yours.</p><p>Compatibility depends on your filter's specifications and connections, so please check before you buy.</p>"}}, {"type": "question", "settings": {"question": "Do I need Farless replacement filters?", "answer": "<p>No. There are no Farless-only filters to buy.</p><p>Choose a compatible system from the brand you trust, and keep to the maintenance schedule that suits your home.</p>"}}, {"type": "question", "settings": {"question": "How clean is the filtered water?", "answer": "<p>That depends on the filtration system you choose, as each one is designed to reduce different contaminants.</p><p>We recommend a certified system that matches your household's water.</p>"}}, {"type": "question", "settings": {"question": "Can I adjust the boiling water temperature?", "answer": "<p>Yes. Adjustable temperature settings let you pour exactly what you need, from tea and coffee to water for cooking.</p>"}}, {"type": "question", "settings": {"question": "Is boiling water safe with children around?", "answer": "<p>Safety is built in. Boiling water only flows once the pin is pressed and the handle turned, and a built-in child-safety lock helps prevent it starting by accident.</p><p>We still recommend an adult nearby whenever very hot water is in use.</p>"}}, {"type": "question", "settings": {"question": "Can it pour chilled sparkling water?", "answer": "<p>Yes. Choose chilled or room-temperature sparkling water, whenever the mood strikes.</p>"}}, {"type": "question", "settings": {"question": "How does the sparkling water work?", "answer": "<p>A carbonation system with a replaceable CO₂ cylinder adds the bubbles right at your tap.</p><p>When the cylinder runs out, swap in a new one and carry on.</p>"}}, {"type": "question", "settings": {"question": "Is it still an everyday kitchen tap?", "answer": "<p>Absolutely. Hot and cold water work just as you'd expect, for washing up, rinsing vegetables and cleaning.</p><p>The extra waters add convenience and take nothing away.</p>"}}, {"type": "question", "settings": {"question": "Do I replace the whole tap when the CO₂ runs out?", "answer": "<p>No. Only the CO₂ cylinder needs replacing. Your tap stays exactly where it is.</p>"}}, {"type": "question", "settings": {"question": "What if something goes wrong?", "answer": "<p>Every Farless comes with a 5-year warranty.</p>"}}]}
  ]
}
{% endschema %}
