{%- comment -%} Questions: one block per question; each opens to show its answer. {%- endcomment -%}
{%- render 'farless-arc', arc: section.settings.arc -%}
<section class="sec faq{% if section.settings.tone %} tone{% endif %}" id="{{ section.settings.anchor | default: 'questions' | handleize }}" aria-labelledby="h-{{ section.id }}">
  <div class="wrap">
    <div class="side" data-in>
      <span class="label kicker part">{{ section.settings.kicker | escape }}</span>
      <h2 class="h2 part" id="h-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      <span class="drop part" aria-hidden="true"></span>
    </div>
    <div>
      {%- for block in section.blocks %}
      <details {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}<span class="pm" aria-hidden="true"></span></summary>{{ block.settings.answer }}</details>
      {%- endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Farless questions",
  "tag": "div",
  "class": "farless-questions",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 20,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small label", "default": "Questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Good to know." },
    { "type": "header", "content": "Layout" },
    { "type": "text", "id": "anchor", "label": "Link name", "default": "questions", "info": "Menu links ending in #questions jump here." },
    { "type": "checkbox", "id": "tone", "label": "Slightly lighter background", "default": false },
    { "type": "select", "id": "arc", "label": "Arc line above", "default": "none", "options": [ { "value": "none", "label": "None" }, { "value": "left", "label": "From the left" }, { "value": "right", "label": "From the right" } ] }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Is it safe with children around?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Yes. Boiling water needs a push and a turn at the same time, so it can't start by accident.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Farless questions",
      "blocks": [
        { "type": "question" },
        { "type": "question", "settings": { "question": "What if something goes wrong?", "answer": "<p>Every Farless comes with a 5-year warranty.</p>" } },
        { "type": "question", "settings": { "question": "Does it really replace the kettle?", "answer": "<p>Yes. Boiling water is ready the moment you turn the dial. No waiting, no refilling.</p>" } },
        { "type": "question", "settings": { "question": "Will I run out of sparkling water bottles?", "answer": "<p>There are no bottles to run out of. Sparkling water comes straight from the tap.</p>" } }
      ]
    }
  ]
}
{% endschema %}
