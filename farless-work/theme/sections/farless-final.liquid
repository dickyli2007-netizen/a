{%- comment -%} The closing call to buy, with slow rising bubbles behind it. {%- endcomment -%}
{%- render 'farless-arc', arc: section.settings.arc -%}
<section class="sec final{% if section.settings.tone %} tone{% endif %}" id="{{ section.settings.anchor | default: 'buy' | handleize }}" aria-labelledby="h-{{ section.id }}">
  {%- if section.settings.bubbles %}
  <div class="bubbles" aria-hidden="true"><i style="--x:12%;--s:6px;--t:14s;--dl:-3s"></i><i style="--x:28%;--s:4px;--t:11s;--dl:-8s"></i><i style="--x:44%;--s:9px;--t:16s;--dl:-1s"></i><i style="--x:61%;--s:5px;--t:12s;--dl:-6s"></i><i style="--x:77%;--s:7px;--t:15s;--dl:-10s"></i><i style="--x:90%;--s:4px;--t:10s;--dl:-4s"></i></div>
  {%- endif %}
  <div class="wrap" data-in>
    <span class="label part">{{ section.settings.kicker | escape }}</span>
    <h2 class="h2 part" id="h-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.lede != blank %}
    <p class="lede part">{{ section.settings.lede | escape }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank %}
    <a class="btn solid part" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>
    {%- endif %}
  </div>
</section>

{% schema %}
{
  "name": "Farless final call",
  "tag": "div",
  "class": "farless-final",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small label", "default": "Farless" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Make room." },
    { "type": "textarea", "id": "lede", "label": "Text", "default": "Five waters. One tap. Far less on your counter." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Buy Farless" },
    { "type": "url", "id": "button_link", "label": "Button link", "default": "/collections" },
    { "type": "checkbox", "id": "bubbles", "label": "Rising bubbles", "default": true },
    { "type": "header", "content": "Layout" },
    { "type": "text", "id": "anchor", "label": "Link name", "default": "buy", "info": "Menu links ending in #buy jump here." },
    { "type": "checkbox", "id": "tone", "label": "Slightly lighter background", "default": true },
    { "type": "select", "id": "arc", "label": "Arc line above", "default": "none", "options": [ { "value": "none", "label": "None" }, { "value": "left", "label": "From the left" }, { "value": "right", "label": "From the right" } ] }
  ],
  "presets": [ { "name": "Farless final call" } ]
}
{% endschema %}
