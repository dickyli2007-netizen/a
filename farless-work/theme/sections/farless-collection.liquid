{%- comment -%}
  A collection page in the Farless style: each product stands alone on the dark page as its cut-out,
  in the soft light and with the contact shadow of its product page. Cut-outs come from the first
  colour's variant image (or the product's first picture); Shadow position (farless.foot_x) places the
  shadow. Products with photos instead of cut-outs can fill the card with the Pictures setting.
{%- endcomment -%}
{%- paginate collection.products by section.settings.per_page -%}
<style>
.cl{padding:calc(118px + env(safe-area-inset-top, 0px)) var(--gutter) clamp(96px,13vh,150px)}
.cl.tone{background:var(--canvas-2)}
.cl .crumbs{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:clamp(28px,5vh,56px)}
.cl .crumbs a{text-decoration:none;color:var(--text-secondary);transition:color .35s var(--ease-out)}
.cl .crumbs a:hover{color:var(--text-primary)}
.cl .crumbs [aria-current]{color:var(--text-primary)}
.cl-head{display:flex;justify-content:space-between;align-items:end;gap:24px 48px;flex-wrap:wrap;margin-bottom:clamp(48px,8vh,88px)}
.cl-head > div{min-width:0}
.cl-head .lede{margin-top:22px}
.cl-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:clamp(48px,7vh,72px) 28px;list-style:none;margin:0;padding:0}
.cl-card{min-width:0}
.cl-card a{display:block;text-decoration:none;color:inherit}
.cl-card a:focus-visible{outline:1px solid var(--accent);outline-offset:6px}
.cl-pic{position:relative;aspect-ratio:4/5;max-width:100%;overflow:hidden;background:var(--panel);isolation:isolate}
.cl-pic::before{content:"";position:absolute;inset:0;z-index:-2;pointer-events:none;background:radial-gradient(52% 44% at 50% 52%,rgba(236,227,214,.085),rgba(236,227,214,0) 72%)}
.cl-obj{position:absolute;left:50%;bottom:10%;height:78%;max-width:86%;aspect-ratio:var(--ar);translate:-50% 0;transform-origin:50% 100%;transition:transform 1.4s var(--ease-out)}
.cl-obj img{display:block;width:100%;height:100%;object-fit:contain}
.cl-obj::after{content:"";position:absolute;z-index:-1;left:var(--shadow-x,50%);top:98.4%;width:var(--shadow-w,0%);height:5%;translate:-50% -50%;background:radial-gradient(closest-side,rgba(4,3,2,.8),rgba(4,3,2,0))}
.cl-card a:hover .cl-obj{transform:scale(1.035)}
.cl-pic.photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform 1.4s var(--ease-out)}
.cl-card a:hover .cl-pic.photo img{transform:scale(1.03)}
.cl-meta{display:flex;justify-content:space-between;align-items:baseline;gap:16px;margin-top:20px}
.cl-meta h2{font:300 1.15rem/1.3 var(--font);letter-spacing:.02em;min-width:0}
.cl-meta .label{flex:none}
.cl-card .sub{color:var(--text-secondary);font-size:.95rem;line-height:1.5;margin-top:6px}
.cl-empty{color:var(--text-secondary);font-size:clamp(1.05rem,1.25vw,1.2rem);max-width:44ch}
.cl-empty .link{display:inline-block;margin-top:28px}
.cl-pages{display:flex;justify-content:center;gap:40px;margin-top:clamp(56px,9vh,96px)}
@media (max-width:600px){
  .cl-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:40px 14px}
  .cl-meta{display:block;margin-top:14px}
  .cl-meta h2{font-size:1rem}
  .cl-meta .label{margin-top:6px}
  .cl-card .sub{font-size:.88rem}
}
@media (prefers-reduced-motion: reduce){.cl-obj,.cl-pic.photo img{transition:none}}
</style>
{%- render 'farless-arc', arc: section.settings.arc -%}
<section class="cl{% if section.settings.tone %} tone{% endif %}" aria-labelledby="h-{{ section.id }}">
  <div class="wrap">
    <nav class="crumbs label" aria-label="Breadcrumb"><a href="{{ routes.root_url }}#shop">{{ section.settings.shop_crumb | escape }}</a><span aria-hidden="true">/</span><span aria-current="page">{{ collection.title | escape }}</span></nav>
    <div class="cl-head" data-in>
      <div>
        <span class="label kicker part">{{ section.settings.kicker | escape }}</span>
        <h1 class="h2 part" id="h-{{ section.id }}">{{ collection.title | escape }}</h1>
        {%- assign about = collection.description | strip_html | strip -%}
        {%- if about != blank %}
        <p class="lede part">{{ about | escape }}</p>
        {%- endif %}
      </div>
      {%- if collection.products_count > 0 %}
      <span class="label part">{% if collection.products_count == 1 %}1 {{ section.settings.piece_label | escape }}{% else %}{{ collection.products_count }} {{ section.settings.pieces_label | escape }}{% endif %}</span>
      {%- endif %}
    </div>

    {%- if collection.products.size > 0 %}
    <ul class="cl-grid" data-in>
      {%- for product in collection.products -%}
        {%- liquid
          assign colour_count = 0
          for option in product.options_with_values
            assign oname = option.name | downcase | strip
            if oname == 'colour' or oname == 'color' or oname == 'finish' or oname == 'colours' or oname == 'colors'
              assign colour_count = option.values.size
              break
            endif
          endfor
          assign pic = product.featured_media
          if section.settings.pictures == 'cutout'
            assign v = product.selected_or_first_available_variant
            if v.featured_media
              assign pic = v.featured_media
            else
              for fv in product.variants
                if fv.featured_media
                  assign pic = fv.featured_media
                  break
                endif
              endfor
            endif
          endif
          assign foot_x = product.metafields.farless.foot_x.value
          assign lede = product.metafields.farless.lede.value
        -%}
      <li class="cl-card part"><a href="{{ product.url }}">
        {%- if section.settings.pictures == 'cutout' %}
        <div class="cl-pic">
          {%- if pic %}<div class="cl-obj" style="--ar:{{ pic.preview_image.aspect_ratio | default: 0.65 }};--shadow-x:{{ foot_x | default: 50 }}%;--shadow-w:{% if foot_x != blank %}34{% else %}0{% endif %}%">{{ pic.preview_image | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 1100px) 31vw, (min-width: 600px) 46vw, 46vw', loading: 'lazy', alt: '' }}</div>{% endif -%}
        </div>
        {%- else %}
        <div class="cl-pic photo">
          {%- if pic %}{{ pic.preview_image | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 1100px) 31vw, (min-width: 600px) 46vw, 46vw', loading: 'lazy', alt: '' }}{% endif -%}
        </div>
        {%- endif %}
        <div class="cl-meta"><h2>{{ product.title | escape }}</h2>
          {%- if product.available == false %}<span class="label">{{ section.settings.sold_out_label | escape }}</span>
          {%- elsif section.settings.show_prices %}<span class="label">{{ product.price | money }}</span>
          {%- elsif colour_count > 1 %}<span class="label">{{ colour_count }} {{ section.settings.colours_label | escape }}</span>{% endif -%}
        </div>
        {%- if lede != blank %}
        <p class="sub">{{ lede | escape }}</p>
        {%- endif %}
      </a></li>
      {%- endfor %}
    </ul>
    {%- if paginate.pages > 1 %}
    <nav class="cl-pages" aria-label="{{ section.settings.pages_label | escape }}">
      {%- if paginate.previous %}<a class="link" href="{{ paginate.previous.url }}">{{ section.settings.previous_label | escape }}</a>{% endif -%}
      {%- if paginate.next %}<a class="link" href="{{ paginate.next.url }}">{{ section.settings.next_label | escape }}</a>{% endif -%}
    </nav>
    {%- endif %}
    {%- else %}
    <div class="cl-empty" data-in>
      <p class="part">{{ section.settings.empty_text | escape }}</p>
      <a class="link part" href="{{ routes.root_url }}#shop">{{ section.settings.empty_link_label | escape }}</a>
    </div>
    {%- endif %}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Farless collection",
  "tag": "div",
  "class": "farless-collection",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small label", "default": "Collection" },
    { "type": "select", "id": "pictures", "label": "Pictures", "default": "cutout", "options": [ { "value": "cutout", "label": "Cut-outs on the dark page" }, { "value": "photo", "label": "Photos that fill the card" } ], "info": "Cut-outs use each product's first colour picture; photos use its first picture." },
    { "type": "checkbox", "id": "show_prices", "default": false, "label": "Show prices" },
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 6, "max": 48, "step": 6, "default": 24 },
    { "type": "header", "content": "Labels" },
    { "type": "text", "id": "shop_crumb", "label": "First link in the trail", "default": "Shop" },
    { "type": "text", "id": "piece_label", "label": "One product", "default": "piece" },
    { "type": "text", "id": "pieces_label", "label": "Several products", "default": "pieces" },
    { "type": "text", "id": "colours_label", "label": "Colours", "default": "colours" },
    { "type": "text", "id": "sold_out_label", "label": "Sold out", "default": "Sold out" },
    { "type": "text", "id": "empty_text", "label": "Empty collection", "default": "Coming soon." },
    { "type": "text", "id": "empty_link_label", "label": "Link from an empty collection", "default": "Back to the shop" },
    { "type": "text", "id": "pages_label", "label": "Page links name", "default": "More pieces" },
    { "type": "text", "id": "previous_label", "label": "Previous page", "default": "Previous" },
    { "type": "text", "id": "next_label", "label": "Next page", "default": "Next" },
    { "type": "header", "content": "Layout" },
    { "type": "checkbox", "id": "tone", "label": "Slightly lighter background", "default": false },
    { "type": "select", "id": "arc", "label": "Arc line above", "default": "none", "options": [ { "value": "none", "label": "None" }, { "value": "left", "label": "From the left" }, { "value": "right", "label": "From the right" } ] }
  ]
}
{% endschema %}
