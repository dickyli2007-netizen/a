  {%- liquid
    assign fp = section.settings.product
    assign plist = section.settings.shop_products
    assign many = false
    if plist != blank
      if plist.size == 1
        assign fp = plist.first
      else
        assign many = true
      endif
    endif
  -%}
  <section class="sec shop tone" id="shop" aria-labelledby="shop-h">
    <div class="wrap">
      <div class="head" data-in>
        <div>
          <span class="label kicker part">Shop</span>
          <h2 class="h2 part" id="shop-h">Bring Farless home.</h2>
        </div>
      </div>

      {%- if many -%}
      <ul class="pgrid" data-in>
        {%- for p in plist -%}
        <li class="pcard part"><a href="{{ p.url }}">
          <div class="pimg">
            {%- if p.featured_media -%}
              {{ p.featured_media.preview_image | image_url: width: 900 | image_tag: widths: '400, 600, 900', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy', alt: p.featured_media.alt }}
            {%- endif -%}
            {%- if p.media.size > 1 -%}
              {{ p.media[1].preview_image | image_url: width: 900 | image_tag: widths: '400, 600, 900', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy', alt: '' }}
            {%- endif -%}
          </div>
          <h3>{{ p.title }}</h3>
          {%- if section.settings.show_prices -%}<span class="price">{{ p.price | money }}</span>{%- endif -%}
          {%- unless p.available -%}<span class="sold label">Sold out</span>{%- endunless -%}
        </a></li>
        {%- endfor -%}
      </ul>
      {%- elsif fp != blank -%}
      {%- assign v = fp.selected_or_first_available_variant -%}
      <div class="feature" data-in>
        <div class="f-media part" data-gallery>
          <div class="f-frame">
            {%- if fp.featured_media -%}
              {{ fp.featured_media.preview_image | image_url: width: 1400 | image_tag: widths: '600, 900, 1200, 1400', sizes: '(min-width: 860px) 52vw, 100vw', loading: 'lazy', alt: fp.featured_media.alt, class: 'f-main' }}
            {%- endif -%}
          </div>
          {%- if fp.media.size > 1 -%}
          <div class="f-thumbs" role="group" aria-label="Product images">
            {%- for m in fp.media limit: 6 -%}
              {%- if m.preview_image -%}
              <button type="button" data-src="{{ m.preview_image | image_url: width: 1400 }}" data-srcset="{{ m.preview_image | image_url: width: 600 }} 600w, {{ m.preview_image | image_url: width: 900 }} 900w, {{ m.preview_image | image_url: width: 1400 }} 1400w" data-alt="{{ m.alt | escape }}" aria-label="Show image {{ forloop.index }}"{% if forloop.first %} aria-current="true"{% endif %}>{{ m.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}</button>
              {%- endif -%}
            {%- endfor -%}
          </div>
          {%- endif -%}
        </div>
        <div class="f-info">
          <span class="label part">The tap</span>
          <h3 class="part">{{ fp.title }}</h3>
          {%- if fp.description != blank -%}
          <p class="excerpt part">{{ fp.description | strip_html | remove: 'Five waters. One tap.' | strip | truncatewords: 34 }}</p>
          {%- endif -%}
          {%- if section.settings.show_prices -%}<p class="price part">{{ v.price | money }}</p>{%- endif -%}
          <div class="f-actions part">
            {%- form 'product', fp -%}
              <input type="hidden" name="id" value="{{ v.id }}">
              <button class="btn" type="submit"{% unless v.available %} disabled{% endunless %}>{% if v.available %}Add to cart{% else %}Sold out{% endif %}</button>
            {%- endform -%}
            <a class="link" href="{{ fp.url }}">View details</a>
          </div>
          <ul class="f-notes part">
            <li><span class="label">Five waters</span>Boiling, filtered, sparkling, hot and cold.</li>
            <li><span class="label">Push and turn</span>Boiling only when you mean it.</li>
            <li><span class="label">5-year warranty</span>On every Farless.</li>
          </ul>
        </div>
      </div>
      {%- endif -%}

      {%- if section.settings.collections != blank -%}
      <div class="collections" data-in>
        <div class="chead part"><span class="label">Collections</span><a class="link" href="{{ routes.collections_url }}">View all</a></div>
        <ul class="ccards">
          {%- for c in section.settings.collections -%}
          {%- liquid
            assign cimg = c.featured_image
            if cimg == blank and c.products.first.featured_media
              assign cimg = c.products.first.featured_media.preview_image
            endif
          -%}
          <li class="ccard part"><a href="{{ c.url }}">
            {%- if cimg -%}
            <div class="cimg">{{ cimg | image_url: width: 1000 | image_tag: widths: '500, 750, 1000', sizes: '(min-width: 990px) 33vw, 100vw', loading: 'lazy', alt: c.title }}</div>
            {%- else -%}
            <div class="cimg empty" aria-hidden="true"><svg viewBox="0 0 200 120"><path d="M30 118 V58 C30 22 58 4 100 4 C142 4 170 22 170 58 V82"/><circle cx="170" cy="98" r="3"/></svg></div>
            {%- endif -%}
            <div class="cmeta"><h3>{{ c.title }}</h3><span class="label">{% if c.products_count == 0 %}Coming soon{% elsif c.products_count == 1 %}1 piece{% else %}{{ c.products_count }} pieces{% endif %}</span></div>
          </a></li>
          {%- endfor -%}
        </ul>
      </div>
      {%- endif -%}
    </div>
  </section>
